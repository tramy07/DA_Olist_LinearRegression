        "# Filter out coordinates outside Brazil (lat ~ -34..6, lng ~ -74..-34)\n",
        "in_brazil = (geolocation['geolocation_lat'].between(-34, 6) &\n",
        "             geolocation['geolocation_lng'].between(-74, -34))\n",
        "print(f\"Removed {(~in_brazil).sum()} geolocation points outside Brazil\")\n",
        "\n",
        "# Median coordinates by area code (zip prefix)\n",
        "geo = (geolocation[in_brazil]\n",
        "       .groupby('geolocation_zip_code_prefix')\n",
        "       .agg(lat=('geolocation_lat', 'median'), lng=('geolocation_lng', 'median'))\n",
        "       .reset_index())\n",
        "\n",
        "# Coordinates of customers and sellers\n",
        "cust_geo = (customers.merge(geo, left_on='customer_zip_code_prefix',\n",
        "                            right_on='geolocation_zip_code_prefix', how='left')\n",
        "            [['customer_id', 'customer_state', 'lat', 'lng']]\n",
        "            .rename(columns={'lat': 'cust_lat', 'lng': 'cust_lng'}))\n",
        "\n",
        "sell_geo = (sellers.merge(geo, left_on='seller_zip_code_prefix',\n",
        "                          right_on='geolocation_zip_code_prefix', how='left')\n",
        "            [['seller_id', 'seller_state', 'lat', 'lng']]\n",
        "            .rename(columns={'lat': 'sell_lat', 'lng': 'sell_lng'}))\n",
        "\n",
        "# Haversine formula: distance (km) between 2 points given longitude and latitude\n",
        "def haversine(lat1, lon1, lat2, lon2):\n",
        "    lat1, lon1, lat2, lon2 = map(np.radians, [lat1, lon1, lat2, lon2])\n",
        "    a = np.sin((lat2 - lat1) / 2) ** 2 + np.cos(lat1) * np.cos(lat2) * np.sin((lon2 - lon1) / 2) ** 2\n",
        "    return 6371 * 2 * np.arcsin(np.sqrt(a))\n",
        "\n",
        "# Each row = 1 item. Use a left join so rows are NOT silently lost, then check\n",
        "items = order_items[['order_id', 'seller_id']].merge(df[['order_id', 'customer_id']], on='order_id', how='inner')\n",
        "n_items = len(items)\n",
        "items = items.merge(cust_geo, on='customer_id', how='left')\n",
        "items = items.merge(sell_geo, on='seller_id', how='left')\n",
        "assert len(items) == n_items, \"join changed the number of rows\"\n",
        "\n",
        "items['distance_km'] = haversine(items['cust_lat'], items['cust_lng'],\n",
        "                                 items['sell_lat'], items['sell_lng'])\n",
        "items['same_state'] = (items['customer_state'] == items['seller_state']).astype(int)\n",
        "\n",
        "print(f\"Number of items: {n_items}; missing distance: {items['distance_km'].isna().sum()} items\")\n",
        "\n",
        "# Aggregate to the order level\n",
        "geo_features = items.groupby('order_id').agg(\n",
        "    distance_km=('distance_km', 'max'),\n",
        "    same_state=('same_state', 'min')\n",
        ").reset_index()\n",
        "\n",
        "print(geo_features.describe())"
