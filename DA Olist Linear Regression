        "outputId": "7d662c53-ff6e-4b19-d6ff-2a1c1d694bc9"
      },
      "outputs": [
        {
          "name": "stdout",
          "output_type": "stream",
          "text": [
            "Variable pairs with |r| > 0.7: [('weight_total_g', 'volume_total_cm3', np.float64(0.831))]\n",
            "        Variable  Corr with y (train)   VIF Decision\n",
            "     distance_km                0.434 1.657     Keep\n",
            "      same_state               -0.404 1.498     Keep\n",
            "  weight_total_g                0.071 3.616     Keep\n",
            "volume_total_cm3                0.063 3.529     Keep\n",
            "   total_freight                0.181 2.856     Keep\n",
            "     total_price                0.054 1.230     Keep\n",
            "      item_count               -0.017 1.311     Keep\n"
          ]
        }
      ],
      "source": [
        "imp_diag = SimpleImputer(strategy='median').fit(X_train[numeric_features])\n",
        "Xn = pd.DataFrame(imp_diag.transform(X_train[numeric_features]),\n",
        "                  columns=numeric_features, index=X_train.index)\n",
        "\n",
        "# Highly correlated variable pairs\n",
        "corr_abs = Xn.corr().abs()\n",
        "pairs = [(a, b, round(corr_abs.loc[a, b], 3))\n",
        "         for i, a in enumerate(corr_abs.columns) for b in corr_abs.columns[i + 1:]\n",
        "         if corr_abs.loc[a, b] > 0.7]\n",
        "print(\"Variable pairs with |r| > 0.7:\", pairs if pairs else \"none\")\n",
        "\n",
        "# VIF\n",
        "Xn_const = sm.add_constant(Xn)\n",
        "vif = [variance_inflation_factor(Xn_const.values, i + 1) for i in range(len(numeric_features))]\n",
        "\n",
        "selection = pd.DataFrame({\n",
        "    'Variable': numeric_features,\n",
        "    'Corr with y (train)': [Xn[c].corr(y_train) for c in numeric_features],\n",
        "    'VIF': vif\n",
        "})\n",
        "selection['Decision'] = np.where(selection['VIF'] > 10, 'Consider dropping', 'Keep')\n",
        "selection.to_csv('figures/x_selection_vif.csv', index=False)\n",
        "print(selection.round(3).to_string(index=False))\n",
        "# The one-hot variables (state, month, day of week) are categorical so VIF is not evaluated here."
      ]
