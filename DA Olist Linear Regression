        "# Product volume = length x height x width (missing values left as NaN, to be imputed in the Pipeline)\n",
        "products['volume_cm3'] = (products['product_length_cm'] *\n",
        "                          products['product_height_cm'] *\n",
        "                          products['product_width_cm'])\n",
        "\n",
        "# TOTAL weight and volume of the items in the order (min_count=1: if every item is missing, keep NaN)\n",
        "prod_features = (order_items[['order_id', 'product_id']]\n",
        "                 .merge(products[['product_id', 'product_weight_g', 'volume_cm3']], on='product_id', how='left')\n",
        "                 .groupby('order_id')[['product_weight_g', 'volume_cm3']].sum(min_count=1)\n",
        "                 .rename(columns={'product_weight_g': 'weight_total_g',\n",
        "                                  'volume_cm3': 'volume_total_cm3'})\n",
        "                 .reset_index())\n",
        "\n",
        "# Time features\n",
        "df['purchase_month'] = df['order_purchase_timestamp'].dt.month\n",
        "df['purchase_dayofweek'] = df['order_purchase_timestamp'].dt.dayofweek\n",
        "\n",
        "# Combine everything into 1 table, check the row count\n",
        "n = len(df)\n",
        "model_df = df.merge(geo_features, on='order_id', how='left')\n",
        "assert len(model_df) == n\n",
        "model_df = model_df.merge(prod_features, on='order_id', how='left')\n",
        "assert len(model_df) == n\n",
        "\n",
        "# Drop orders whose distance cannot be computed (missing coordinates), do not fill in fake numbers\n",
        "n_no_dist = model_df['distance_km'].isna().sum()\n",
        "model_df = model_df.dropna(subset=['distance_km']).reset_index(drop=True)\n",
        "log_step('Drop orders missing distance (missing coordinates)', n_no_dist, len(model_df))\n",
        "print(f\"Dropped {n_no_dist} orders missing distance -> {len(model_df)} orders remaining\")\n",
        "\n",
        "# Numeric variables\n",
        "numeric_features = ['distance_km', 'same_state', 'weight_total_g', 'volume_total_cm3',\n",
        "                    'total_freight', 'total_price', 'item_count']\n",
        "\n",
        "# Categorical variables -> one-hot (drop 1 level as the reference to avoid perfect multicollinearity)\n",
        "dummies = pd.get_dummies(\n",
